export _draw, _update, _init

State = {}
global _init = (dt) ->
  State = {}
  State.my_number = 0
global _update = (dt) ->
  State.my_number += 1

global _draw = (dt) ->
  gfx.clear(gfx.COLOR_BLACK)
  gfx.text("Hello YueScript! #{State.my_number}", 10, 10, gfx.COLOR_WHITE)
  gfx.text("dt: #{dt}", 10, 32, gfx.COLOR_PEACH)
